{
  "name": "watcher",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript rewrite of the X/Twitter watcher",
  "type": "commonjs",
  "main": "dist/cli.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:fg": "tsx src/cli.ts start --foreground",
    "migrate:v1": "tsx src/cli.ts migrate:v1",
    "start": "node dist/cli.js start",
    "start:fg": "node dist/cli.js start --foreground",
    "stop": "node dist/cli.js stop",
    "status": "node dist/cli.js status",
    "login": "tsx src/cli.ts login",
    "catchup": "tsx src/cli.ts catchup",
    "test": "vitest run",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-autostart.ps1 -Install",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-autostart.ps1 -Remove",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-autostart.ps1 -Status"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "form-data": "^4.0.6",
    "node-telegram-bot-api": "^2.1.0",
    "playwright-core": "~1.62.1",
    "twspace-crawler": "1.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false
  }
}
