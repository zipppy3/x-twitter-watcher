# ── Twitter Authentication ──
# Get these values from your browser DevTools -> Application -> Cookies -> x.com
TWITTER_AUTH_TOKEN=
TWITTER_CSRF_TOKEN=

# ── Telegram Notifications (Optional) ──
# 1. Message @BotFather on Telegram to create a bot and get a token
# 2. Start a chat with your bot, then get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Telegram Auto-Upload Topics (Optional) ──
# Thread IDs (from the Topic URL in your Telegram Group)
TELEGRAM_AUDIO_THREAD_ID=
TELEGRAM_METADATA_THREAD_ID=
TELEGRAM_TWEET_THREAD_ID=
TELEGRAM_TWEET_METADATA_THREAD_ID=

# Topic for the watcher's own notices: started/stopped, "Space is live",
# health alerts and the daily "still alive" line. Leave empty to post them in the
# group's General topic. If General is closed, they go to the metadata topic instead.
TELEGRAM_STATUS_THREAD_ID=

# ── Telegram 50MB Limit Bypass (Optional) ──
# To upload files larger than 50MB, run a Local Telegram Bot API Server via Docker.
# 1. Get your API ID and API Hash from https://my.telegram.org
# 2. Fill in the values below, then run: docker compose up -d
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://127.0.0.1:9201

# ── Data Management (Optional) ──
# Automatically delete local files after successful Telegram upload
# Set to true to save disk space on long-running servers
AUTO_DELETE_UPLOADED=false

# Root directory for all downloads (screenshots, audio, metadata)
# Default is ./download
DOWNLOAD_ROOT=

# ── Data Source & Nitter Integration (Optional) ──
# Select where to fetch tweets from: 'twitter' or 'nitter'
# Default is 'twitter'. Switch to 'nitter' if you encounter rate limits.
DATA_SOURCE=twitter

# Primary Nitter instance URL (required if DATA_SOURCE=nitter)
NITTER_URL=https://nitter.net

# Comma-separated list of fallback Nitter URLs
NITTER_FALLBACK_URLS=https://nitter.cz,https://nitter.poast.org

# ── Proxy Configuration (Optional) ──
# Enable proxies to prevent IP bans during scraping and screenshot capturing
PROXY_ENABLED=false

# Comma-separated list of proxy URLs (http://user:pass@host:port)
PROXY_LIST=

# Set to true if PROXY_LIST contains a single third-party rotating proxy endpoint.
# This disables internal cooldowns, relying on the provider to rotate IPs.
PROXY_IS_ROTATING_ENDPOINT=false

# If true, the system will try requests without a proxy first,
# and only use the proxy if the host IP gets banned/rate-limited (e.g. 403, 429).
PROXY_FALLBACK_ON_BAN=false

# ── Screenshots (Optional) ──
# Take X screenshots with your session instead of logged out. Shows the whole
# conversation above a tweet (full threads), but uses your account in an
# automated browser.
SCREENSHOT_LOGGED_IN=false

# Python interpreter that has the `camoufox` package (see requirements.txt).
# Leave empty to use ./.venv, then whatever `python` is on PATH.
CAMOUFOX_PYTHON=

# ── Health monitoring (Optional) ──
# Send a Telegram alert when a data source (X API, Nitter, Spaces polling,
# screenshots) has been failing for this many minutes. Default: 15
HEALTH_ALERT_AFTER_MINUTES=15

# Local hour (0-23) of the daily "still alive" summary. Default: 9. Use "off" to disable.
HEALTH_DAILY_REPORT_HOUR=9
