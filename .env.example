# ── Twitter Authentication ──
# Get these values from your browser DevTools -> Application -> Cookies -> x.com
TWITTER_AUTH_TOKEN=
TWITTER_CSRF_TOKEN=

# ── Telegram Notifications (Optional) ──
# 1. Message @BotFather on Telegram to create a bot and get a token
# 2. Start a chat with your bot, then get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Telegram Auto-Upload Topics (Optional) ──
# Thread IDs (from the Topic URL in your Telegram Group)
TELEGRAM_AUDIO_THREAD_ID=
TELEGRAM_METADATA_THREAD_ID=
TELEGRAM_TWEET_THREAD_ID=
TELEGRAM_TWEET_METADATA_THREAD_ID=

# ── Telegram 50MB Limit Bypass (Optional) ──
# To upload files larger than 50MB, run a Local Telegram Bot API Server via Docker.
# 1. Get your API ID and API Hash from https://my.telegram.org
# 2. Fill in the values below, then run: docker compose up -d
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://127.0.0.1:8081

# ── Data Management (Optional) ──
# Automatically delete local files after successful Telegram upload
# Set to true to save disk space on long-running servers
AUTO_DELETE_UPLOADED=false

# Root directory for all downloads (screenshots, audio, metadata)
# Default is ./download
DOWNLOAD_ROOT=

# ── Data Source & Nitter Integration (Optional) ──
# Select where to fetch tweets from: 'twitter' or 'nitter'
# Default is 'twitter'. Switch to 'nitter' if you encounter rate limits.
DATA_SOURCE=twitter

# Primary Nitter instance URL (required if DATA_SOURCE=nitter)
NITTER_URL=https://nitter.net

# Comma-separated list of fallback Nitter URLs
NITTER_FALLBACK_URLS=https://nitter.cz,https://nitter.poast.org

# ── Proxy Configuration (Optional) ──
# Enable proxies to prevent IP bans during scraping and screenshot capturing
PROXY_ENABLED=false

# Comma-separated list of proxy URLs (http://user:pass@host:port)
PROXY_LIST=
